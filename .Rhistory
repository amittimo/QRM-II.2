# Laad hier alle benodigde packages in voor het hele project, dit moet elke keer als je het bestand opnieuw opent.
library(tidyverse)
library(moments)
library(car)
# Laad hiermee de dataset in.
movies <- read_tsv("data/movies5.tsv")
# Laad hier alle benodigde packages in voor het hele project, dit moet elke keer als je het bestand opnieuw opent.
library(tidyverse)
library(moments)
library(car)
# Laad hiermee de dataset in.
movies <- read_tsv("data/movies5.tsv")
#WRITE YOUR CODE HERE
genre_freq_table <- table(movies$genre)
#WRITE YOUR CODE HERE
genre_freq_table <- table(movies$genre)
sort(genre_freq_table, decreasing = TRUE)[1:3]
movies$genre2 <- ifelse(movies$genre %in% c("Drama", "Comedy", "Thriller"),
movies$genre,
"Other")
table(movies$genre2)
# Alle 0en als NA's weergeven
movies$log_revenue <- ifelse(movies$revenue <= 0, NA, log(movies$revenue))
movies$log_budget <- ifelse(movies$budget <= 0, NA, log(movies$budget))
# Schat OLS model
model_c <- lm(log_revenue ~ log_budget + factor(genre2) + release_year, data = movies)
summary(model_c)
View(model_c)
# Laad hier alle benodigde packages in voor het hele project, dit moet elke keer als je het bestand opnieuw opent.
library(tidyverse)
library(moments)
library(car)
# Laad hiermee de dataset in.
movies <- read_tsv("data/movies5.tsv")
# Runtime in model zetten om specifieke film te schatten
model_d <- lm(log_revenue ~ log_budget + factor(genre2) + release_year + runtime, data = movies)
View(movies)
# Frequentie tabel van de genre variabel
genre_freq_table <- table(movies$genre)
# Sorteer om de top 3 te vinden
sort(genre_freq_table, decreasing = TRUE)[1:3]
# Creëer een variabel die Drama, Comedy en Thriller laat zien en de rest bij elkaar voegt onder 'Other'
movies$genre2 <- ifelse(movies$genre %in% c("Drama", "Comedy", "Thriller"),
movies$genre,
"Other")
# Laat de tabel zien met de nieuwe variabele
table(movies$genre2)
# Alle 0en als NA's weergeven
movies$log_revenue <- ifelse(movies$revenue <= 0, NA, log(movies$revenue))
movies$log_budget <- ifelse(movies$budget <= 0, NA, log(movies$budget))
# Schat OLS model
model_c <- lm(log_revenue ~ log_budget + factor(genre2) + release_year, data = movies)
summary(model_c)
# Runtime in model zetten om specifieke film te schatten
model_d <- lm(log_revenue ~ log_budget + factor(genre2) + release_year + runtime, data = movies)
# Dataframe maken voor 2026 drama movie (met budget van 20,000,000)
new_movie <- data.frame(
log_budget = log(20000000),
genre2 = "Drama",
release_year = 2026,
runtime = 120
)
# Schat log omzet met 90% prediction interval
pred_log <- predict(model_d, newdata = new_movie, interval = "prediction", level = 0.90)
# Exponenteer om resultaten in USD te krijgen
exp(pred_log)
View(pred_log)
# Plot de residuals tegen fitted values om heteroskedasticity te checken
plot(model_d$fitted.values, resid(model_d),
main = "Residuals vs. Fitted Values",
xlab = "Fitted Values",
ylab = "Residuals")
abline(h = 0, col = "red")
# Plot de residuals tegen fitted values om heteroskedasticity te checken
plot(model_d$fitted.values, resid(model_d),
main = "Residuals vs. Fitted Values",
xlab = "Fitted Values",
ylab = "Residuals")
abline(h = 0, col = "red")
# Schat een nieuw model met release_month als een categorisch variabel
model_f <- lm(log_revenue ~ log_budget + factor(genre2) + release_year + runtime + factor(release_month), data = movies)
# Voer een F-test (anova) uit die de twee modellen vergelijkt
anova(model_d, model_f)
# Schat een nieuw model met release_month als een categorisch variabel
model_f <- lm(log_revenue ~ log_budget + factor(genre2) + release_year + runtime + factor(release_month), data = movies)
# Voer een F-test (anova) uit die de twee modellen vergelijkt
anova(model_d, model_f)
# Schat een nieuw model met release_month als een categorisch variabel
model_f <- lm(log_revenue ~ log_budget + factor(genre2) + release_year + runtime + factor(release_month), data = movies)
# Voer een F-test (anova) uit die de twee modellen vergelijkt
anova(model_d, model_f)
